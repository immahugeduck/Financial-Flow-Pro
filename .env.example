# ============================================================
# Financial-Flow-Pro — Environment Variables Reference
# ============================================================
# Copy this file to .env (for local development) and fill in
# the values.  Never commit the real .env file.
# ============================================================

# ------------------------------------------------------------
# FRONTEND  (prefix every variable with REACT_APP_)
# ------------------------------------------------------------

# URL of the deployed backend API server (no trailing slash).
# Examples:
#   Local dev  : http://localhost:8000
#   Production : https://your-backend-service.example.com
REACT_APP_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------

# MongoDB connection string (required)
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net

# MongoDB database name (required)
DB_NAME=financial_flow

# Secret key used to sign JWT tokens — use a long random string (required)
JWT_SECRET=change-me-to-a-long-random-secret

# JWT signing algorithm (optional, default: HS256)
JWT_ALGORITHM=HS256

# JWT token lifetime in minutes (optional, default: 1440 = 24 h)
TOKEN_EXPIRY_MINUTES=1440

# Comma-separated list of allowed CORS origins (optional, default: *)
# In production, restrict this to your Vercel deployment URL.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# ------------------------------------------------------------
# Google OAuth (optional — required only if Google login is enabled)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# Gemini AI (optional — required only if AI financial insights are enabled)
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# ------------------------------------------------------------
# Plaid (optional — required only if bank account linking is enabled)
# ------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# Plaid environment: sandbox | development | production (default: sandbox)
PLAID_ENV=sandbox
